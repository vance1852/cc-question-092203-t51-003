# 运行环境：development / test / production（默认 development）
# 生产环境（production/prod）下，签名密钥或管理员口令不满足安全基线时服务将拒绝启动
APP_ENV=development

# JWT 签名密钥：生产环境必须设置为至少 32 个字符的强随机值，且不得使用内置默认值
# APP_SECRET_KEY=

# 首次启动引导的管理员账号（仅首次建库时生效）
# 生产环境口令需至少 12 个字符，且不得使用默认口令 admin123
# APP_ADMIN_USERNAME=admin
# APP_ADMIN_PASSWORD=

# 服务端口
# APP_PORT=7634
